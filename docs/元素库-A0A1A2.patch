+    const ch = src[i];
+    if (quote) {
+      out += ch;
+      if (ch === '\\') { out += src[i + 1] ?? ''; i += 1; continue; }
+      if (ch === quote) quote = '';
+      continue;
+    }
+    if (ch === '"' || ch === "'" || ch === '`') { quote = ch; out += ch; continue; }
+    if (ch === '(') { depth += 1; if (depth === 1) continue; }
+    if (ch === ')') {
+      depth -= 1;
+      if (depth === 0) return { raw: out, next: i + 1, closed: true };
+    }
+    out += ch;
+  }
