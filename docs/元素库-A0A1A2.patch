+/** `get_by_role` → `getByRole`：Python 的蛇形与 JS/Java 的驼峰在这一步拉平 */
+export function camelOf(name: string): string {
+  return String(name ?? '').replace(/_([a-z0-9])/g, (_, c: string) => c.toUpperCase());
