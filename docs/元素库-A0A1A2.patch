+  const s = String(text ?? '');
+  if (/AriaRole\s*\./.test(s) || /new\s+(?:Page|Locator|FrameLocator)\.[A-Za-z]*Options\s*\(/.test(s)) return 'java';
+  if (/\bget_by_[a-z_]+\s*\(/.test(s) || /\bframe_locator\s*\(/.test(s)) return 'python';
+  return 'js';
