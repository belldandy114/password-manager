+### [A2-3] 出参**事实字段**（`found / total / visible / inIframe / reason / label`）
+
+```ts
+/** A 组：**查询事实**，只在会话就绪、查询真的执行过时出现（7 值）。 */
+export type HitQueryReason =
+  | 'ok' | 'not-found' | 'not-visible' | 'iframe-only' | 'login-required'
+  | 'unsupported' | 'timeout';
+/** B 组：**会话事实**，会话没起来 / 中途失效时出现（5 值）；与 A 组同属**一个** 12 值枚举。 */
+export type HitSessionReason =
+  | 'no-browser' | 'launch-failed' | 'attach-failed' | 'locked' | 'element-missing';
+/** 完整 12 值 —— **渲染层状态机数量以 `[Z-9]` 的全表为准**，不许只做 A 组 7 个（会留 5 个孤立 reason）。 */
+export type HitReason = HitQueryReason | HitSessionReason;
+
+export interface ElHitFacts {
+  found: boolean;        // total > 0
+  total: number;         // 命中数，上限 50（超出 truncated:true）
+  truncated: boolean;    // total 触顶
+  visible: boolean;      // 第一个命中的可见性：[A2-3] 下行的定义
+  inIframe: boolean;     // 第一个命中是否位于子框架内；本期**恒为 false**（[N-2]）
+  iframes: number;       // 主文档里 iframe 的数量（给 reason='iframe-only' 用）
+  reason: HitQueryReason; // 只取 A 组 7 值；B 组走顶层 `ElHitTestResult.reason`（[Z-9]）
+  label: string;         // 第一个命中的可读标签，≤ 40 字（只回界面，不落盘，见 [A2-13]）
+  approx: boolean;       // 语义是否为近似实现（text / role / pw 为 true）
+  kind: string;          // 归一后的 kind（回显，便于面板显示「验的是哪一种」）
+  locator: string;       // 回显（来源一时为主进程从库取到的真值）
+  roleName?: string;
+  source: 'vault' | 'draft';
+  pageId?: string;
+  elementId?: string;
+  ms: number;
+}
+
+export interface ElHitSession {
+  open: boolean;
+  sessionId: string;     // [A2-5]
+  browserId: string;     // 'chrome' | 'msedge'
+  port: number;          // 从 DevToolsActivePort 读到的真实端口（0 = 尚未就绪）
+  url: string;           // 当前页地址（脱敏后的 host + path，见 [A2-13]）
+  startedAt: string;
+  lastHitAt: string;
+  idleStopInMs: number;  // 距空闲自停还剩多久（[A2-6]）
+}
+
+/** 通道出参（与 `[A2-1]` 的 data 列一一对应）。v3 补定义：此前只在通道表里以行内形态出现。 */
+export interface ElHitTestResult {
+  op: 'verify' | 'status' | 'stop';
+  /** 只在 A 组（`[Z-9]` 1–7）出现；与 `reason` **互斥** */
+  hit?: ElHitFacts;
+  /** 只在 B 组（`[Z-9]` 8–12）出现；此时**没有** `hit`（`[A2-4]`） */
+  reason?: HitSessionReason;
+  session: ElHitSession;
+  stopped?: boolean;      // op='stop'
+  killed?: boolean;       // op='stop'：是否走了 L2/L3（[A2-11]）
+  alreadyStopped?: boolean; // op='stop' 幂等重入（[A2-5]）
+}
+```
+
+**`visible` 的定义（逐字，可断言）**：`visible = (el.getClientRects().length > 0) && (getComputedStyle(el).visibility !== 'hidden')`。与 Playwright `isVisible()` 对齐：**`opacity: 0` 仍算 visible**，`display:none` / 零尺寸 / `visibility:hidden` 算不可见。这条口径必须写死，否则面板上的「可见」和试跑回填的 `visible`（Playwright 的判定）会对不上。
+
+**`reason` 的语义（每个值只对应一种事实）**：
+
+| reason | 何时给 | 面板文案（逐字） |
+|---|---|---|
+| `ok` | `total > 0` | `命中 N 个，第一个可见 / 不可见` |
+| `not-found` | `total === 0` 且非登录页 | `没命中：页面上找不到这条定位器` |
+| `not-visible` | `total > 0` 且 `visible === false` | `命中了但不可见（可能被折叠 / 隐藏）` |
+| `iframe-only` | `total === 0` 且 `iframes > 0` | `主文档没命中，但页面有 N 个 iframe；本版不进 iframe（[N-2]）` |
+| `login-required` | `total === 0` 且页面被判定为登录页（有 `input[type=password]` 或 URL 命中 `/login\|signin\|sso\|passport\|auth/i`，复用 `element-args.js:422-426` 的口径） | `页面需要登录：在打开的浏览器里登录后再点一次` |
+| `unsupported` | 定位方式不在点验白名单内（`[A2-7]` 的清单） | `这条定位器暂不支持浏览器点验（请在 Playwright 试跑里验证）` |
+| `timeout` | 查询段超预算（`[A2-6]`），**已连上浏览器** | `点验超时（已返回已完成的事实），请重试` |
+
+> **上表只是 A 组（查询事实，7 值）。`HitReason` 的完整取值是 12 个 —— 见 `[Z-9]` 全表**；渲染层状态机数量以 `[Z-9]` 为准。
