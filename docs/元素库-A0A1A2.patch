+      return {
+        stdout: JSON.stringify({
+          CommandLine: `"chrome.exe" --user-data-dir="${profileDir}"`,
+          CreationDate: opts && opts.creation ? opts.creation : `/Date(${Date.now()})/`,
+        }),
+        status: 0,
+      };
+    }) as unknown as typeof spawnSync;
+  }
+
+  beforeEach(() => {
+    _reset();
+  });
