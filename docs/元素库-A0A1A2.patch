+      log: () => {},
+      audit: () => {},
+      spawnSync: fakeSpawn(calls),
+    });
+    const v = verifyProcess(4242, profileDir, new Date(Date.now() - 5000).toISOString());
+    expect(v.ok).toBe(true);
+    expect(calls.map((c) => c[0])).toContain('pwsh');
+  });
