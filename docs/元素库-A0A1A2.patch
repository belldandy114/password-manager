+  | 'css'
+  | 'xpath'
+  | 'label'
+  | 'placeholder'
+  | 'text'
+  | 'alttext'
+  | 'title'
+  | 'testid'
+  | 'role'
+  | 'pw';
+
+/** 三个合法 op（缺省 verify） */
+export type HitOp = 'verify' | 'status' | 'stop';
+
+/** 事实的 7 个 reason（[A2-3]：每个值只对应一种事实） */
+export type HitReason =
+  | 'ok'
+  | 'not-found'
+  | 'not-visible'
+  | 'iframe-only'
+  | 'login-required'
+  | 'unsupported'
+  | 'timeout';
+
+/** 归一后的事实（[A2-3]） */
+export interface HitFacts {
+  found: boolean;
+  total: number;
+  truncated: boolean;
+  visible: boolean;
+  inIframe: boolean;
+  iframes: number;
+  reason: HitReason;
+  label: string;
+  approx: boolean;
+  kind: string;
+  locator: string;
+  roleName?: string;
+  source: 'vault' | 'draft';
+  pageId?: string;
+  elementId?: string;
+  ms: number;
+}
+
+/** 校验通过后的点验计划 */
+export interface HitPlan {
+  op: string;
+  source: 'vault' | 'draft';
+  url: string;
+  kind: HitKind;
+  locator: string;
+  roleName: string;
+  pageId?: string;
+  elementId?: string;
+  timeoutMs: number;
+  budget: HitBudget;
+}
+
+/** 三段超时预算（[A2-6]） */
+export interface HitBudget {
+  total: number;
+  launch: number;
+  attach: number;
+  query: number;
+}
+
+/** 校验结果：错误一律返回、不抛 */
+export type HitValidateResult =
+  | { ok: true; op: HitOp; plan: HitPlan | null }
+  | { ok: false; error: string; code: string };
+
+/** 入参（与 src/types.ts 的 ElHitTestInput 同形；这里不 import 渲染层类型，保持单向） */
+export interface HitTestInput {
+  op?: HitOp;
+  pageId?: string;
+  elementId?: string;
+  locator?: string;
+  kind?: HitKind | string;
+  roleName?: string;
+  url?: string;
+  timeoutMs?: number;
+}
+
